# ⚠️  SECURITY WARNING: This is an EXAMPLE file only
# - NEVER commit the real .env file to version control
# - ALWAYS add .env to .gitignore before using
# - Keep OKX_PRIVATE_KEY and OKX_API_KEY extremely secure and private
# - Rotate credentials immediately if exposed

OKX_MANUAL_TEST=true

# ========== REQUIRED CONFIGURATION ==========

# OKX_FROM_TOKEN: Source token symbol or contract address for the swap
# Format: Token symbol (e.g., "ETH", "USDC") OR contract address (e.g., "0x...")
# Example: ETH
OKX_FROM_TOKEN=

# OKX_TO_TOKEN: Destination token symbol or contract address for the swap
# Format: Token symbol (e.g., "USDT", "DAI") OR contract address (e.g., "0x...")
# Example: USDC
OKX_TO_TOKEN=

# OKX_AMOUNT: Swap amount in decimal units (not base units)
# Format: Decimal number (e.g., "1.5", "100.25")
# Note: Amount is in token decimals, not wei/lamports
# Example: 1.5
OKX_AMOUNT=

# OKX_PRIVATE_KEY: Solana or EVM private key for signing transactions
# Format: Without "0x" prefix for most chains, or with "0x" for EVM (check your chain)
# ⚠️  CRITICAL: This is extremely sensitive. Never share or expose.
# Example: abc123def456... (64 hex chars for most chains)
OKX_PRIVATE_KEY=

# OKX_API_KEY: API Key from OKX console (Developers > API Management > Create API Key)
# Format: Alphanumeric string provided by OKX
# Source: https://www.okx.com/account/api-management
# Example: your-api-key-string
OKX_API_KEY=

# OKX_SECRET_KEY: Secret key from OKX console (paired with API_KEY)
# Format: Secret string provided by OKX at API key creation time
# ⚠️  Only shown once during creation—save it immediately and securely
# Source: https://www.okx.com/account/api-management
OKX_SECRET_KEY=

# OKX_API_PASSPHRASE: Passphrase set during OKX API key creation
# Format: String of your choice (5-32 characters, set by you during API key setup)
# Source: https://www.okx.com/account/api-management
OKX_API_PASSPHRASE=

# OKX_PROJECT_ID: Project ID from OKX console
# Format: Numeric or alphanumeric project identifier
# Source: https://www.okx.com/account/api-management (under API key details)
OKX_PROJECT_ID=

# ========== OPTIONAL CONFIGURATION ==========

# OKX_FROM_ADDRESS: Override wallet address for the swap source
# When to use: Only if you want to use a different wallet than the one derived from OKX_PRIVATE_KEY
# Format: Public key/wallet address string
# Default: Automatically derived from OKX_PRIVATE_KEY if not set (leave empty for automatic derivation)
# Example: GrwWA1S9qq3qVChpyWftszmjWxzqegyQa2lewKMT516 (or EVM: 0x1234...)
OKX_FROM_ADDRESS=

# OKX_SLIPPAGE: Maximum allowed price slippage for the swap
# Units: Percentage (%)
# Format: Decimal number (e.g., "2" for 2%, "0.5" for 0.5%)
# Range: Typically 0.1 to 50 (percent)
# Default: 2%
# Example: 2 (meaning the swap will tolerate up to 2% price slippage)
OKX_SLIPPAGE=2

# OKX_FEE: Protocol/platform fee percentage charged on the swap
# Units: Percentage (%)
# Format: Decimal number (e.g., "0.2" for 0.2%, "0.5" for 0.5%)
# Range: Typically 0.1 to 1.0 (percent)
# Default: 0.2%
# Example: 0.2 (meaning 0.2% of the swap amount is charged as fee)
OKX_FEE=0.2

# OKX_FROM_TOKEN_REFERRER: Optional referrer wallet address or code for source token referral rewards
# Purpose: Earn referral rewards when swapping the source token through a referrer program
# Format: Public key/wallet address string or referrer code
# Default: None (no referrer, no rewards)
# Example: GrwWA1S9qq3qVChpyWftszmjWxzqegyQa2lewKMT516 (or EVM: 0x1234..., or referrer code)
OKX_FROM_TOKEN_REFERRER=

# OKX_TO_TOKEN_REFERRER: Optional referrer wallet address or code for destination token referral rewards
# Purpose: Earn referral rewards when swapping to the destination token through a referrer program
# Format: Public key/wallet address string or referrer code
# Default: None (no referrer, no rewards)
# Example: GrwWA1S9qq3qVChpyWftszmjWxzqegyQa2lewKMT516 (or EVM: 0x1234..., or referrer code)
OKX_TO_TOKEN_REFERRER=
